#include <winver.h>

// Numeric ID 1 ensures Explorer / taskbar use this as the default exe icon
// (Windows picks the lowest-numbered ICON resource).
1 ICON "@NUI_SFTP_ICO_FORWARD@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @SEMVER_MAJOR@,@SEMVER_MINOR@,@SEMVER_PATCH@,0
 PRODUCTVERSION @SEMVER_MAJOR@,@SEMVER_MINOR@,@SEMVER_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tim Ebbeke"
            VALUE "FileDescription",  "nui-sftp - SSH & SFTP workbench"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "nui-sftp"
            VALUE "LegalCopyright",   "Copyright (C) Tim Ebbeke"
            VALUE "OriginalFilename", "nui-sftp.exe"
            VALUE "ProductName",      "nui-sftp"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
