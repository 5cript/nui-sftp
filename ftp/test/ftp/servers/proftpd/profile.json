{
    "image": "nui-sftp-ftp-test-proftpd",
    "runArguments": ["--init"],
    "ports": {"plain": 21, "explicit": 21, "implicit": 990},
    "users": [{"name": "ftptest", "password": "ftptest"}],
    "variants": {
        "default": {"command": ["default"]},
        "throttled": {"command": ["throttled"], "runArguments": ["--cap-add", "NET_ADMIN"]},
        "limits": {"command": ["limits"]}
    },
    "expectations": {
        "features": {"mlsd": true, "mlst": true, "mfmt": true, "utf8": true, "epsv": true},
        "advertised": ["AUTH TLS", "EPRT", "EPSV", "MDTM", "MFMT", "PBSZ", "PROT", "REST STREAM", "SIZE", "TVFS", "UTF8"],
        "modificationTime": "mfmt",
        "abortReplies": {"plain": [426, 226], "tls": [226, 426]},
        "finalReplyWaitsForDataClose": {"plain": true, "tls": true},
        "sessionReuseRequired": true,
        "missingReuse": "keepsSession",
        "connectionLimit": "afterPass",
        "repliesTell550Causes": true,
        "listOfMissingDirectory": "failsAfterPreliminary"
    }
}
