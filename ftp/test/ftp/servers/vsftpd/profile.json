{
    "image": "nui-sftp-ftp-test-vsftpd",
    "runArguments": ["--init"],
    "ports": {"plain": 21, "explicit": 21, "implicit": 990},
    "users": [{"name": "ftptest", "password": "ftptest"}],
    "variants": {
        "default": {"command": ["default"]},
        "throttled": {
            "command": ["throttled"],
            "runArguments": ["--cap-add", "NET_ADMIN", "--sysctl", "net.ipv4.tcp_wmem=4096 16384 65536"]
        },
        "limits": {"command": ["limits"]}
    },
    "expectations": {
        "features": {"mlsd": false, "mlst": false, "mfmt": false, "utf8": true, "epsv": true},
        "advertised": ["EPRT", "EPSV", "MDTM", "PASV", "PBSZ", "PROT", "REST STREAM", "SIZE", "TVFS"],
        "modificationTime": "mdtm",
        "repliesTell550Causes": false,
        "resumesDataSessions": true
    }
}
