{
    "version": 1,
    "preset": {
        "name": "Disks & Files",
        "icon": "documents",
        "description": {
            "en_US": "Find what fills the disk and where files are.",
            "de_DE": "Herausfinden, was die Platte füllt und wo Dateien liegen."
        }
    },
    "snippets": [
        {
            "name": "Free space",
            "command": "df -h",
            "tags": ["disk"],
            "danger": "safe"
        },
        {
            "name": "Free inodes",
            "command": "df -i",
            "tags": ["disk"],
            "danger": "safe"
        },
        {
            "name": "Block devices",
            "command": "lsblk -f",
            "tags": ["disk"],
            "danger": "safe"
        },
        {
            "name": "Mounted filesystems",
            "command": "findmnt",
            "tags": ["disk"],
            "danger": "safe"
        },
        {
            "name": "Disk health (smartmontools)",
            "command": "sudo smartctl -H -A {{device}}",
            "tags": ["disk"],
            "danger": "safe"
        },
        {
            "name": "Biggest directories",
            "command": "du -xh --max-depth=1 {{path}} 2>/dev/null | sort -h | tail -20",
            "tags": ["usage"],
            "danger": "safe"
        },
        {
            "name": "Biggest files",
            "command": "find {{path}} -xdev -type f -size +{{megabytes}}M -exec ls -lh {} + | sort -k5 -h | tail -20",
            "tags": ["usage"],
            "danger": "safe"
        },
        {
            "name": "Deleted files still open",
            "command": "sudo lsof +L1",
            "tags": ["usage"],
            "danger": "safe"
        },
        {
            "name": "Find files by name",
            "command": "find {{path}} -iname \"*{{pattern}}*\"",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Recently modified files",
            "command": "find {{path}} -type f -mmin -{{minutes}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Search text in files",
            "command": "grep -rn \"{{pattern}}\" {{path}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Mount device",
            "command": "sudo mount {{device}} {{mountPoint}}",
            "tags": ["disk"],
            "danger": "caution"
        },
        {
            "name": "Unmount",
            "command": "sudo umount {{mountPoint}}",
            "tags": ["disk"],
            "danger": "caution"
        }
    ]
}
