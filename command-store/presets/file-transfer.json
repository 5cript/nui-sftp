{
    "version": 1,
    "preset": {
        "name": "File Transfer",
        "icon": "upload",
        "description": {
            "en_US": "rsync, scp and downloads between machines.",
            "de_DE": "rsync, scp und Downloads zwischen Rechnern."
        }
    },
    "snippets": [
        {
            "name": "Copy to host (rsync)",
            "command": "rsync -avzP {{source}} {{user}}@{{host}}:{{destination}}",
            "tags": ["rsync"],
            "danger": "caution"
        },
        {
            "name": "Copy from host (rsync)",
            "command": "rsync -avzP {{user}}@{{host}}:{{source}} {{destination}}",
            "tags": ["rsync"],
            "danger": "caution"
        },
        {
            "name": "Mirror directory, preview",
            "command": "rsync -avzn --delete {{source}}/ {{destination}}/",
            "tags": ["rsync"],
            "danger": "safe"
        },
        {
            "name": "Mirror directory",
            "command": "rsync -avz --delete {{source}}/ {{destination}}/",
            "tags": ["rsync"],
            "danger": "danger"
        },
        {
            "name": "Copy to host (scp)",
            "command": "scp {{file}} {{user}}@{{host}}:{{destination}}",
            "tags": ["scp"],
            "danger": "caution"
        },
        {
            "name": "Download file",
            "command": "curl -fLO {{url}}",
            "tags": ["download"],
            "danger": "caution"
        },
        {
            "name": "Resume download",
            "command": "wget -c {{url}}",
            "tags": ["download"],
            "danger": "caution"
        },
        {
            "name": "Serve directory on localhost over HTTP",
            "command": "python3 -m http.server --bind 127.0.0.1 {{port}}",
            "tags": ["http"],
            "danger": "caution"
        }
    ]
}
