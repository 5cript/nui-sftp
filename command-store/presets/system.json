{
    "version": 1,
    "preset": {
        "name": "System",
        "icon": "it-host",
        "description": {
            "en_US": "Host name, time, and restarting or shutting down the machine.",
            "de_DE": "Hostname, Zeit sowie Neustart und Herunterfahren der Maschine."
        }
    },
    "snippets": [
        {
            "name": "Host information",
            "command": "hostnamectl",
            "tags": ["host"],
            "danger": "safe"
        },
        {
            "name": "Set host name",
            "command": "sudo hostnamectl set-hostname {{hostname}}",
            "tags": ["host"],
            "danger": "caution"
        },
        {
            "name": "Time and synchronization",
            "command": "timedatectl",
            "tags": ["time"],
            "danger": "safe"
        },
        {
            "name": "Set time zone",
            "command": "sudo timedatectl set-timezone {{timezone}}",
            "tags": ["time"],
            "danger": "caution"
        },
        {
            "name": "Locale and keyboard",
            "command": "localectl",
            "tags": ["host"],
            "danger": "safe"
        },
        {
            "name": "Previous boots",
            "command": "sudo journalctl --list-boots --no-pager | tail -10",
            "tags": ["power"],
            "danger": "safe"
        },
        {
            "name": "Reboot in minutes",
            "command": "sudo shutdown -r +{{minutes}}",
            "tags": ["power"],
            "danger": "caution"
        },
        {
            "name": "Cancel scheduled shutdown",
            "command": "sudo shutdown -c",
            "tags": ["power"],
            "danger": "caution"
        },
        {
            "name": "Reboot now",
            "command": "sudo systemctl reboot",
            "tags": ["power"],
            "danger": "danger"
        },
        {
            "name": "Power off",
            "command": "sudo systemctl poweroff",
            "tags": ["power"],
            "danger": "danger"
        }
    ]
}
