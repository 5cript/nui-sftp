{
    "version": 1,
    "preset": {
        "name": "apk",
        "icon": "product",
        "description": {
            "en_US": "Package management on Alpine Linux, also inside containers.",
            "de_DE": "Paketverwaltung unter Alpine Linux, auch in Containern."
        }
    },
    "snippets": [
        {
            "name": "Update and upgrade",
            "command": "apk update && apk upgrade",
            "tags": ["update"],
            "danger": "caution"
        },
        {
            "name": "Upgradable packages",
            "command": "apk version -l '<'",
            "tags": ["update"],
            "danger": "safe"
        },
        {
            "name": "Search package",
            "command": "apk search {{package}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Package details",
            "command": "apk info -a {{package}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Install package",
            "command": "apk add {{package}}",
            "tags": ["install"],
            "danger": "caution"
        },
        {
            "name": "Install without cache",
            "command": "apk add --no-cache {{package}}",
            "tags": ["install"],
            "danger": "caution"
        },
        {
            "name": "Remove package",
            "command": "apk del {{package}}",
            "tags": ["remove"],
            "danger": "caution"
        },
        {
            "name": "Installed packages",
            "command": "apk info",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Package owning file",
            "command": "apk info --who-owns {{file}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Files of package",
            "command": "apk info -L {{package}}",
            "tags": ["search"],
            "danger": "safe"
        }
    ]
}
