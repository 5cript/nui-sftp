{
    "version": 1,
    "preset": {
        "name": "Certificates",
        "icon": "locked",
        "description": {
            "en_US": "Check, create and renew TLS certificates with openssl and certbot.",
            "de_DE": "TLS-Zertifikate mit openssl und certbot prüfen, erstellen und erneuern."
        }
    },
    "snippets": [
        {
            "name": "Certificate of server",
            "command": "openssl s_client -connect {{host}}:{{port}} -servername {{host}} </dev/null 2>/dev/null | openssl x509 -noout -subject -issuer -dates",
            "tags": ["inspect"],
            "danger": "safe"
        },
        {
            "name": "Certificate details",
            "command": "openssl x509 -in {{certificate}} -noout -text",
            "tags": ["inspect"],
            "danger": "safe"
        },
        {
            "name": "Expiry date",
            "command": "openssl x509 -in {{certificate}} -noout -enddate",
            "tags": ["inspect"],
            "danger": "safe"
        },
        {
            "name": "Key matches certificate",
            "command": "openssl x509 -noout -pubkey -in {{certificate}} | sha256sum\nopenssl pkey -pubout -in {{key}} | sha256sum",
            "tags": ["inspect"],
            "danger": "safe"
        },
        {
            "name": "Self-signed certificate",
            "command": "openssl req -x509 -newkey rsa:4096 -nodes -keyout {{name}}.key -out {{name}}.crt -days 365 -subj \"/CN={{name}}\"",
            "tags": ["create"],
            "danger": "caution"
        },
        {
            "name": "Certificate signing request",
            "command": "openssl req -new -newkey rsa:2048 -nodes -keyout {{name}}.key -out {{name}}.csr -subj \"/CN={{name}}\"",
            "tags": ["create"],
            "danger": "caution"
        },
        {
            "name": "Managed certificates (certbot)",
            "command": "sudo certbot certificates",
            "tags": ["certbot"],
            "danger": "safe"
        },
        {
            "name": "Test renewal (certbot)",
            "command": "sudo certbot renew --dry-run",
            "tags": ["certbot"],
            "danger": "safe"
        },
        {
            "name": "Random secret",
            "command": "openssl rand -base64 {{bytes}}",
            "tags": ["secrets"],
            "danger": "safe"
        },
        {
            "name": "File checksum",
            "command": "sha256sum {{file}}",
            "tags": ["checksums"],
            "danger": "safe"
        }
    ]
}
