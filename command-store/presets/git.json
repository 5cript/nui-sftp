{
    "version": 1,
    "preset": {
        "name": "Git",
        "icon": "source-code",
        "description": {
            "en_US": "Everyday repository work on the server.",
            "de_DE": "Alltägliche Arbeit mit Repositories auf dem Server."
        }
    },
    "snippets": [
        {
            "name": "Status",
            "command": "git status -sb",
            "tags": ["status"],
            "danger": "safe"
        },
        {
            "name": "Compact history",
            "command": "git log --oneline --graph --decorate -n 30",
            "tags": ["history"],
            "danger": "safe"
        },
        {
            "name": "History of file",
            "command": "git log -p --follow -n 10 -- {{file}}",
            "tags": ["history"],
            "danger": "safe"
        },
        {
            "name": "Fetch and prune",
            "command": "git fetch --all --prune",
            "tags": ["remote"],
            "danger": "safe"
        },
        {
            "name": "Pull with rebase",
            "command": "git pull --rebase",
            "tags": ["remote"],
            "danger": "caution"
        },
        {
            "name": "Push",
            "command": "git push",
            "tags": ["remote"],
            "danger": "caution"
        },
        {
            "name": "Remotes",
            "command": "git remote -v",
            "tags": ["remote"],
            "danger": "safe"
        },
        {
            "name": "Switch branch",
            "command": "git switch {{branch}}",
            "tags": ["branches"],
            "danger": "caution"
        },
        {
            "name": "Create branch",
            "command": "git switch -c {{branch}}",
            "tags": ["branches"],
            "danger": "safe"
        },
        {
            "name": "Branches with upstream",
            "command": "git branch -vv",
            "tags": ["branches"],
            "danger": "safe"
        },
        {
            "name": "Unstaged changes",
            "command": "git diff",
            "tags": ["changes"],
            "danger": "safe"
        },
        {
            "name": "Staged changes",
            "command": "git diff --staged",
            "tags": ["changes"],
            "danger": "safe"
        },
        {
            "name": "Commit staged changes",
            "command": "git commit -m \"{{message}}\"",
            "tags": ["changes"],
            "danger": "caution"
        },
        {
            "name": "Undo last commit, keep changes",
            "command": "git reset --soft HEAD~1",
            "tags": ["changes"],
            "danger": "caution"
        },
        {
            "name": "Stash changes",
            "command": "git stash push -m \"{{message}}\"",
            "tags": ["stash"],
            "danger": "caution"
        },
        {
            "name": "Restore stash",
            "command": "git stash pop",
            "tags": ["stash"],
            "danger": "caution"
        },
        {
            "name": "Discard changes of file",
            "command": "git restore {{file}}",
            "tags": ["changes"],
            "danger": "danger"
        },
        {
            "name": "Who changed these lines",
            "command": "git blame -L {{fromLine}},{{toLine}} {{file}}",
            "tags": ["history"],
            "danger": "safe"
        },
        {
            "name": "Untracked files that clean would remove",
            "command": "git clean -nd",
            "tags": ["changes"],
            "danger": "safe"
        }
    ]
}
