{
    "version": 1,
    "preset": {
        "name": "DNF",
        "icon": "product",
        "description": {
            "en_US": "Package management on Fedora, RHEL and their relatives.",
            "de_DE": "Paketverwaltung unter Fedora, RHEL und Verwandten."
        }
    },
    "snippets": [
        {
            "name": "Upgrade",
            "command": "sudo dnf upgrade --refresh",
            "tags": ["update"],
            "danger": "caution"
        },
        {
            "name": "Available updates",
            "command": "dnf check-update",
            "tags": ["update"],
            "danger": "safe"
        },
        {
            "name": "Search package",
            "command": "dnf search {{package}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Package details",
            "command": "dnf info {{package}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Install package",
            "command": "sudo dnf install {{package}}",
            "tags": ["install"],
            "danger": "caution"
        },
        {
            "name": "Remove package",
            "command": "sudo dnf remove {{package}}",
            "tags": ["remove"],
            "danger": "caution"
        },
        {
            "name": "Remove unused packages",
            "command": "sudo dnf autoremove",
            "tags": ["cleanup"],
            "danger": "caution"
        },
        {
            "name": "Clean package cache",
            "command": "sudo dnf clean all",
            "tags": ["cleanup"],
            "danger": "caution"
        },
        {
            "name": "Installed packages",
            "command": "dnf list --installed",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Package providing file",
            "command": "dnf provides {{file}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Files of package",
            "command": "rpm -ql {{package}}",
            "tags": ["search"],
            "danger": "safe"
        },
        {
            "name": "Transaction history",
            "command": "dnf history",
            "tags": ["history"],
            "danger": "safe"
        },
        {
            "name": "Undo transaction",
            "command": "sudo dnf history undo {{transaction}}",
            "tags": ["history"],
            "danger": "danger"
        }
    ]
}
