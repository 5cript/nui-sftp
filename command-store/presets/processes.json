{
    "version": 1,
    "preset": {
        "name": "Processes",
        "icon": "sys-monitor",
        "description": {
            "en_US": "CPU and memory hogs, process lookup and background jobs.",
            "de_DE": "CPU- und Speicherfresser, Prozesssuche und Hintergrundjobs."
        }
    },
    "snippets": [
        {
            "name": "Top CPU users",
            "command": "ps aux --sort=-%cpu | head -15",
            "tags": ["monitoring"],
            "danger": "safe"
        },
        {
            "name": "Top memory users",
            "command": "ps aux --sort=-%mem | head -15",
            "tags": ["monitoring"],
            "danger": "safe"
        },
        {
            "name": "Memory",
            "command": "free -h",
            "tags": ["monitoring"],
            "danger": "safe"
        },
        {
            "name": "Uptime and load",
            "command": "uptime",
            "tags": ["monitoring"],
            "danger": "safe"
        },
        {
            "name": "Find process",
            "command": "pgrep -af {{pattern}}",
            "tags": ["lookup"],
            "danger": "safe"
        },
        {
            "name": "Process tree",
            "command": "ps -ef --forest",
            "tags": ["lookup"],
            "danger": "safe"
        },
        {
            "name": "Open files of process",
            "command": "sudo lsof -p {{pid}}",
            "tags": ["lookup"],
            "danger": "safe"
        },
        {
            "name": "Terminate process",
            "command": "kill {{pid}}",
            "tags": ["control"],
            "danger": "caution"
        },
        {
            "name": "Terminate by name",
            "command": "pkill -f {{pattern}}",
            "tags": ["control"],
            "danger": "danger"
        },
        {
            "name": "Run past logout",
            "command": "nohup {{command}} > {{logFile}} 2>&1 &",
            "tags": ["background"],
            "danger": "caution"
        },
        {
            "name": "Repeat command",
            "command": "watch -n {{seconds}} '{{command}}'",
            "tags": ["monitoring"],
            "danger": "safe"
        },
        {
            "name": "System information",
            "command": "uname -a\ncat /etc/os-release\nlscpu | head -15",
            "tags": ["system"],
            "danger": "safe"
        }
    ]
}
